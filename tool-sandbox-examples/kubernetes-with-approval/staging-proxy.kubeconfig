apiVersion: v1
kind: Config
clusters:
- name: nono-proxy
  cluster:
    server: https://127.0.0.1:18766/kubernetes-api-staging
    insecure-skip-tls-verify: true
contexts:
- name: nono-proxy
  context:
    cluster: nono-proxy
    user: nono-proxy
current-context: nono-proxy
users:
- name: nono-proxy
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1
      command: nono-kube-token-helper
      interactiveMode: Never
