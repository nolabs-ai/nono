{
  "meta": {
    "name": "aws-s3-readonly",
    "version": "0.1.0",
    "description": "Showcase: AWS SigV4 request signing brokered entirely host-side via nono's aws_auth credential route. The aws CLI never holds a usable AWS credential; nono resolves the real credential from the local AWS profile/credential chain and re-signs each outbound request. Read-only S3 access: GET/HEAD allowed, mutating operations denied at the L7 endpoint-policy layer before they reach AWS."
  },
  "workdir": {
    "access": "read"
  },
  "network": {
    "tls_intercept": {
      "ca_lifecycle": "session"
    },
    "credentials": [
      "s3-regional",
      "s3-global"
    ],
    "custom_credentials": {
      "s3-regional": {
        "upstream": "https://my-example-bucket.s3.us-east-1.amazonaws.com",
        "aws_auth": {
          "profile": "default",
          "region": "us-east-1",
          "service": "s3"
        },
        "endpoint_policy": {
          "default": {
            "decision": "deny"
          },
          "allow": [
            {
              "method": "GET",
              "path": "/**",
              "reason": "read-only S3 object/listing access is permitted"
            },
            {
              "method": "HEAD",
              "path": "/**",
              "reason": "read-only S3 metadata access is permitted"
            }
          ],
          "deny": [
            {
              "method": "PUT",
              "path": "/**",
              "reason": "PutObject and multipart uploads are denied"
            },
            {
              "method": "POST",
              "path": "/**",
              "reason": "multipart upload initiation/completion is denied"
            },
            {
              "method": "DELETE",
              "path": "/**",
              "reason": "DeleteObject is denied"
            }
          ]
        }
      },
      "s3-global": {
        "upstream": "https://my-example-bucket.s3.amazonaws.com",
        "aws_auth": {
          "profile": "default",
          "region": "us-east-1",
          "service": "s3"
        },
        "endpoint_policy": {
          "default": {
            "decision": "deny"
          },
          "allow": [
            {
              "method": "GET",
              "path": "/**",
              "reason": "read-only S3 object/listing access is permitted"
            },
            {
              "method": "HEAD",
              "path": "/**",
              "reason": "read-only S3 metadata access is permitted"
            }
          ],
          "deny": [
            {
              "method": "PUT",
              "path": "/**",
              "reason": "PutObject and multipart uploads are denied"
            },
            {
              "method": "POST",
              "path": "/**",
              "reason": "multipart upload initiation/completion is denied"
            },
            {
              "method": "DELETE",
              "path": "/**",
              "reason": "DeleteObject is denied"
            }
          ]
        }
      }
    }
  },
  "environment": {
    "allow_vars": [
      "PATH",
      "HOME",
      "LANG",
      "LC_*",
      "TERM",
      "AWS_EC2_METADATA_DISABLED",
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "AWS_DEFAULT_REGION",
      "SSL_CERT_FILE",
      "REQUESTS_CA_BUNDLE",
      "CURL_CA_BUNDLE"
    ],
    "set_vars": {
      "AWS_EC2_METADATA_DISABLED": "true",
      "AWS_ACCESS_KEY_ID": "dummy-access-key",
      "AWS_SECRET_ACCESS_KEY": "dummy-secret-key",
      "AWS_DEFAULT_REGION": "us-east-1"
    }
  },
  "filesystem": {
    "read": [
      "/opt/homebrew/Cellar/awscli/2.36.7"
    ],
    "read_file": [
      "/opt/homebrew/bin/aws"
    ]
  }
}
